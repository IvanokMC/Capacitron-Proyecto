        {
          "name": "Ingresar como organizador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try { const v = pm.response.json().token; if (v) pm.collectionVariables.set('token_organizador', v) } catch (e) {}",
                  "pm.test('respuesta recibida', () => pm.expect(pm.response.code).to.be.oneOf([200, 400]))"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{apikey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{apikey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
